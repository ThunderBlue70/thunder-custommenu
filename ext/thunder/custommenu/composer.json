{
    "name": "thunder/custommenu",
    "type": "phpbb-extension",
    "description": "A fully configurable menu system for phpBB with dropdown menus, multi-level submenus, Font Awesome icons, Quick Links integration and integrated search.",
    "homepage": "https://github.com/ThunderBlue70/thunder-custommenu",
    "version": "1.0.2",
    "time": "2026-09-09",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "ThunderBlue",
            "homepage": "https://github.com/ThunderBlue70/thunder-custommenu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.2.0"
    },
    "extra": {
        "display-name": "Thunder Custom Menu",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0,<3.4.0"
        },
    "version-check": {
        "host": "thunderblue70.github.io",
        "directory": "/thunder-custommenu",
        "filename": "version_check.json",
        "ssl": true
        }
    }
}
